NODE_ENV=development
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
MAX_UPLOAD_MB=50

# Database. Empty DATABASE_URL = embedded Postgres (PGlite) in PGLITE_DIR, nothing to install.
# For Neon: postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
PGLITE_DIR=./data/pglite

# Uploaded files: an S3-compatible bucket if S3_BUCKET is set (optional), otherwise the
# database when DATABASE_URL is set, otherwise the local folder UPLOAD_DIR.
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
# Backblaze B2:  S3_ENDPOINT=https://s3.<region>.backblazeb2.com,          S3_REGION=<region>
UPLOAD_DIR=./data/uploads
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Number of reverse proxies in front of the app: 0 locally, 1 behind nginx/Caddy, 3 on Render.
TRUST_PROXY=0
