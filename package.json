{
  "name": "fs1-courses",
  "version": "1.0.0",
  "private": true,
  "description": "Course materials site for FS1 Computer Science students",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "cleanup-orphans": "tsx scripts/cleanup-orphans.ts",
    "backup": "tsx scripts/backup.ts",
    "import-sqlite": "tsx scripts/import-sqlite.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@electric-sql/pglite": "^0.5.10",
    "argon2": "^0.45.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "file-type": "^21.3.4",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nunjucks": "^3.2.4",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/nunjucks": "^3.2.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  }
}
